  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-view-open",
    "allow-view-rows",
    "allow-browser-facets",
    "allow-window-settings-get",
    "allow-window-settings-save",
    "allow-import-choose-folder",
